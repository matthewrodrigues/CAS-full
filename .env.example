# Copy to .env for local overrides. Never commit .env.
# Server-only settings: the client reads no env vars (it calls the API on its own origin).

PORT=3000
DATA_DIR=./data

# Set NODE_ENV=production on the host: session cookies become Secure and both passcodes are required.
# NODE_ENV=development

# Host and staff unlock their role with these. Unset in development = that role's login is disabled.
# In production each must be at least 12 characters, and the two must differ. Use long random values.
HOST_PASSCODE=
STAFF_PASSCODE=
